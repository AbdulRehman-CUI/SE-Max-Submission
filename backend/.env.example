# ──────────────────────────────────────────────────────────────────────────────
# SpendSense – Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://spendsense_user:Admin123@localhost:5432/spendsense

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_64_char_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=SpendSense
DEBUG=False

# ── Gemini AI (Developer 2 – do not set here unless coordinating) ──────────────
# GEMINI_API_KEY=your_gemini_api_key_here

