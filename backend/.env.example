# ──────────────────────────────────────────────────────────────────────────────
# SpendSense – Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Local sandbox database ─────────────────────────────────────────────────────
# The SQLite file is created automatically at backend/.sandbox/spendsense.db.
# Replace this with a PostgreSQL URL for deployment or PostgreSQL integration tests.
DATABASE_URL=sqlite:///./.sandbox/spendsense.db

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_64_char_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=SpendSense
DEBUG=False

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=15
